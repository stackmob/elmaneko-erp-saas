# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI environment variables inject runtime configurations.
# Users configure this via environment variables or secret manager.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
# ElManeko3D APP injects this at runtime with the service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
