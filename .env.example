# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI environment variables inject runtime configurations.
# Users configure this via environment variables or secret manager.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted.
# ElManeko3D APP injects this at runtime with the service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Edge Function secrets (configure with `supabase secrets set`, never expose in VITE_ variables).
RESEND_API_KEY="re_xxxxxxxxx"
INVITE_FROM_EMAIL="Equipe <equipe@empresa.com>"

# Chave aleatória com pelo menos 32 caracteres usada somente nas Edge Functions.
# Rotacione-a com procedimento de recuperação; sem a chave, backups anteriores não podem ser restaurados.
BACKUP_ENCRYPTION_KEY="generate-a-long-random-secret-in-a-password-manager"

# Valores emitidos por `supabase status -o env` para testes locais (não usar em produção).
SUPABASE_LOCAL_URL="http://127.0.0.1:54321"
SUPABASE_LOCAL_ANON_KEY=""
SUPABASE_LOCAL_SERVICE_ROLE_KEY=""
