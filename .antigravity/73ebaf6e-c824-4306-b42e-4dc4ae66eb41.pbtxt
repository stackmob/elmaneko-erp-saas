  file_change {
    absolute_path_uri: "file:///src/App.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { \n  Filament, Purchase, Printer, EnergyTariff, Product, \n  ProductionOrder, Budget, Sale, Client, BackupLog, StockMovement, ProductStock \n} from \'./types\';\nimport { \n  INITIAL_FILAMENTS, INITIAL_PRINTERS, INITIAL_CLIENTS, INITIAL_PRODUCTS, \n  INITIAL_PURCHASES, INITIAL_PRODUCTION, INITIAL_BUDGETS, INITIAL_SALES, INITIAL_TARIFFS \n} from \'./data\';\n\n// Component Imports\nimport AuthPage from \'./components/AuthPage\';\nimport Dashboard from \'./components/Dashboard\';\nimport Filaments from \'./components/Filaments\';\nimport Purchases from \'./components/Purchases\';\nimport Printers from \'./components/Printers\';\nimport EnergyTariffModule from \'./components/EnergyTariff\';\nimport Products from \'./components/Products\';\nimport Production from \'./components/Production\';\nimport Budgets from \'./components/Budgets\';\nimport Sales from \'./components/Sales\';\nimport Clients from \'./components/Clients\';\nimport BackupModule from \'./components/Backup\';\n\n// Icons\nimport { \n  LayoutDashboard, Users, Layers, ShoppingBag, Cpu, \n  Zap, FolderHeart, PlayCircle, FileCheck, DollarSign, ShieldAlert, LogOut, Shield, AlertTriangle \n} from \'lucide-react\';\n\nexport default function App() {\n  \n  // 1. AUTH STATE (MVP Auto-logs in first, with full logout support)\n  const [auth, setAuth] = useState<{ isAuthenticated: boolean; email: string }>({\n    isAuthenticated: true,\n    email: \'contato@elmaneko3d.com\'\n  });\n\n  // 2. CENTRAL STATE ENGINE\n  const [filaments, setFilaments] = useState<Filament[]>(() => {\n    const local = localStorage.getItem(\'elmaneko_filaments\');\n    return local ? JSON.parse(local) : INITIAL_FILAMENTS;\n  });\n\n  const [purchases, setPurchases] = useState<Purchase[]>(() => {\n    const local = localStorage.getItem(\'elmaneko_purchases\');\n    return local ? JSON.parse(local) : INITIAL_PURCHASES;\n  });\n\n  const [printers, setPrinters] = useState<Printer[]>(() => {\n    const local = localStorage.getItem(\'elmaneko_printers\');\n    return local ? JSON.parse(local) : INITIAL_PRINTERS;\n  });\n\n  const [tariffs, setTariffs] = useState<EnergyTariff[]>(() => {\n    const local = localStorage.getItem(\'elmaneko_tariffs\');\n    return local ? JSON.parse(local) : INITIAL_TARIFFS;\n  });\n\n  const [products, setProducts] = useState<Product[]>(() => {\n    const local = localStorage.getItem(\'elmaneko_products\');\n    return local ? JSON.parse(local) : INITIAL_PRODUCTS;\n  });\n\n  const [productions, setProductions] = useState<ProductionOrder[]>(() => {\n    const local = localStorage.getItem(\'elmaneko_productions\');\n    return local ? JSON.parse(local) : INITIAL_PRODUCTION;\n  });\n\n  const [budgets, setBudgets] = useState<Budget[]>(() => {\n    const local = localStorage.getItem(\'elmaneko_budgets\');\n    return local ? JSON.parse(local) : INITIAL_BUDGETS;\n  });\n\n  const [sales, setSales] = useState<Sale[]>(() => {\n    const local = localStorage.getItem(\'elmaneko_sales\');\n    return local ? JSON.parse(local) : INITIAL_SALES;\n  });\n\n  const [clients, setClients] = useState<Client[]>(() => {\n    const local = localStorage.getItem(\'elmaneko_clients\');\n    return local ? JSON.parse(local) : INITIAL_CLIENTS;\n  });\n\n  const [backupLogs, setBackupLogs] = useState<BackupLog[]>(() => {\n    const local = localStorage.getItem(\'elmaneko_backup_logs\');\n    return local ? JSON.parse(local) : [];\n  });\n\n  const [currentView, setCurrentView] = useState<string>(\'dashboard\');\n\n  // Sync to localStorage for local persistence (Transient backup fallback)\n  useEffect(() => {\n    localStorage.setItem(\'elmaneko_filaments\', JSON.stringify(filaments));\n  }, [filaments]);\n\n  useEffect(() => {\n    localStorage.setItem(\'elmaneko_purchases\', JSON.stringify(purchases));\n  }, [purchases]);\n\n  useEffect(() => {\n    localStorage.setItem(\'elmaneko_printers\', JSON.stringify(printers));\n  }, [printers]);\n\n  useEffect(() => {\n    localStorage.setItem(\'elmaneko_tariffs\', JSON.stringify(tariffs));\n  }, [tariffs]);\n\n  useEffect(() => {\n    localStorage.setItem(\'elmaneko_products\', JSON.stringify(products));\n  }, [products]);\n\n  useEffect(() => {\n    localStorage.setItem(\'elmaneko_productions\', JSON.stringify(productions));\n  }, [productions]);\n\n  useEffect(() => {\n    localStorage.setItem(\'elmaneko_budgets\', JSON.stringify(budgets));\n  }, [budgets]);\n\n  useEffect(() => {\n    localStorage.setItem(\'elmaneko_sales\', JSON.stringify(sales));\n  }, [sales]);\n\n  useEffect(() => {\n    localStorage.setItem(\'elmaneko_clients\', JSON.stringify(clients));\n  }, [clients]);\n\n  useEffect(() => {\n    localStorage.setItem(\'elmaneko_backup_logs\', JSON.stringify(backupLogs));\n  }, [backupLogs]);\n\n  // 3. MUTATION OPERATIONS\n\n  // Filaments mutations\n  const handleAddFilament = (newFil: Filament) => {\n    setFilaments([...filaments, newFil]);\n  };\n  const handleEditFilament = (editedFil: Filament) => {\n    setFilaments(filaments.map(f => f.id === editedFil.id ? editedFil : f));\n  };\n  const handleDeleteFilament = (id: string) => {\n    setFilaments(filaments.filter(f => f.id !== id));\n  };\n\n  // Purchases mutations (Triggers automated stock credit on insertion!)\n  const handleAddPurchase = (newPur: Purchase) => {\n    setPurchases([newPur, ...purchases]);\n    \n    // Automatically increment filament available stock\n    setFilaments(prev => prev.map(f => {\n      if (f.id === newPur.filamentoId) {\n        return {\n          ...f,\n          quantidadeDisponivel: f.quantidadeDisponivel + newPur.quantidadeAdquirida\n        };\n      }\n      return f;\n    }));\n  };\n\n  // Printers mutations\n  const handleAddPrinter = (newPrint: Printer) => {\n    setPrinters([...printers, newPrint]);\n  };\n  const handleEditPrinter = (editedPrint: Printer) => {\n    setPrinters(printers.map(p => p.id === editedPrint.id ? editedPrint : p));\n  };\n  const handleDeletePrinter = (id: string) => {\n    setPrinters(printers.filter(p => p.id !== id));\n  };\n\n  // Energy Tariff\n  const handleAddTariff = (newTariff: EnergyTariff) => {\n    setTariffs([...tariffs, newTariff]);\n  };\n\n  // Products\n  const handleAddProduct = (newProd: Product) => {\n    setProducts([...products, newProd]);\n  };\n  const handleEditProduct = (editedProd: Product) => {\n    setProducts(products.map(p => p.id === editedProd.id ? editedProd : p));\n  };\n  const handleDeleteProduct = (id: string) => {\n    setProducts(products.filter(p => p.id !== id));\n  };\n\n  // Production Orders (deducts stock and updates status)\n  const handleAddProduction = (\n    order: ProductionOrder, \n    movements: StockMovement[], \n    updatedFil: Filament[]\n  ) => {\n    setProductions([order, ...productions]);\n    if (updatedFil.length > 0) {\n      setFilaments(updatedFil);\n    }\n  };\n\n  const handleUpdateProductionStatus = (\n    orderId: string, \n    status: \'Finalizada\' | \'Cancelada\', \n    movements: StockMovement[], \n    updatedFil: Filament[]\n  ) => {\n    setProductions(prev => prev.map(po => {\n      if (po.id === orderId) {\n        return { ...po, status };\n      }\n      return po;\n    }));\n    if (updatedFil.length > 0) {\n      setFilaments(updatedFil);\n    }\n  };\n\n  // Budgets\n  const handleAddBudget = (newBdg: Budget) => {\n    setBudgets([newBdg, ...budgets]);\n  };\n  const handleEditBudget = (editedBdg: Budget) => {\n    setBudgets(budgets.map(b => b.id === editedBdg.id ? editedBdg : b));\n  };\n  const handleDeleteBudget = (id: string) => {\n    setBudgets(budgets.filter(b => b.id !== id));\n  };\n\n  // Convert Approved Budget into a Direct Sale Order\n  const handleConvertToSale = (\n    budget: Budget, \n    pMethod: \'Pix\' | \'Cart\303\243o de Cr\303\251dito\' | \'Cart\303\243o de D\303\251bito\' | \'Boleto\' | \'Dinheiro\'\n  ) => {\n    // 1. Update budget status\n    setBudgets(prev => prev.map(b => b.id === budget.id ? { ...b, status: \'Aprovado\' } : b));\n\n    // 2. Create Sale object\n    const totalSaleVal = budget.itens.reduce((acc, it) => {\n      return acc + (it.quantidade * (it.valorUnitario - it.desconto));\n    }, 0) - budget.descontoGeral;\n\n    const newSale: Sale = {\n      id: `sal-${Date.now()}`,\n      numero: `VND-2026-${String(sales.length + 1).padStart(4, \'0\')}`,\n      clienteId: budget.clienteId,\n      dataVenda: new Date().toISOString().split(\'T\')[0],\n      itens: budget.itens.map(it => ({\n        produtoId: it.produtoId,\n        quantidade: it.quantidade,\n        valorUnitario: it.valorUnitario,\n        desconto: it.desconto\n      })),\n      valorTotal: totalSaleVal,\n      formaPagamento: pMethod,\n      statusPagamento: \'Pago\', // Marked as fully cleared\n      orcamentoOrigemId: budget.id\n    };\n\n    setSales([newSale, ...sales]);\n  };\n\n  const handleUpdateSaleStatus = (saleId: string, status: Sale[\'statusPagamento\']) => {\n    setSales(prev => prev.map(s => s.id === saleId ? { ...s, statusPagamento: status } : s));\n  };\n\n  // Clients\n  const handleAddClient = (newCli: Client) => {\n    setClients([...clients, newCli]);\n  };\n  const handleEditClient = (editedCli: Client) => {\n    setClients(clients.map(c => c.id === editedCli.id ? editedCli : c));\n  };\n  const handleDeleteClient = (id: string) => {\n    setClients(clients.filter(c => c.id !== id));\n  };\n\n  // Backup & Restorations State overrides\n  const handleAddBackupLog = (newLog: BackupLog) => {\n    setBackupLogs([newLog, ...backupLogs]);\n  };\n\n  const handleRestoreState = (imported: any) => {\n    if (imported.filaments) setFilaments(imported.filaments);\n    if (imported.purchases) setPurchases(imported.purchases);\n    if (imported.printers) setPrinters(imported.printers);\n    if (imported.tariffs) setTariffs(imported.tariffs);\n    if (imported.products) setProducts(imported.products);\n    if (imported.productions) setProductions(imported.productions);\n    if (imported.budgets) setBudgets(imported.budgets);\n    if (imported.sales) setSales(imported.sales);\n    if (imported.clients) setClients(imported.clients);\n  };\n\n  // LOW STOCK ALERT CALCULATOR\n  const lowStockFilaments = filaments.filter(f => f.quantidadeDisponivel <= 200);\n\n  // AUTH CHECK\n  if (!auth.isAuthenticated) {\n    return (\n      <AuthPage \n        onLoginSuccess={(email) => setAuth({ isAuthenticated: true, email })} \n      />\n    );\n  }\n\n  return (\n    <div className=\"min-h-screen bg-black text-white font-sans flex flex-col md:flex-row antialiased\" id=\"elmaneko-erp-app\">\n      \n      {/* SIDEBAR NAVIGATION PANEL */}\n      <aside className=\"w-full md:w-64 bg-neutral-950 border-r border-neutral-900 flex flex-col justify-between shrink-0\" id=\"sidebar\">\n        \n        {/* BRAND LOGO */}\n        <div className=\"p-6 border-b border-neutral-900\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-10 h-10 bg-gradient-to-tr from-orange-600 to-amber-500 rounded-xl flex items-center justify-center font-black text-white text-lg shadow-lg shadow-orange-600/10\">\n              E\n            </div>\n            <div>\n              <h1 className=\"text-md font-black tracking-tight text-white uppercase\">ELMANEKO 3D</h1>\n              <p className=\"text-[9px] font-mono tracking-widest text-orange-500 font-bold\">ERP CONTROL 2.0</p>\n            </div>\n          </div>\n        </div>\n\n        {/* NAVIGATION LINKS */}\n        <nav className=\"flex-1 px-4 py-6 space-y-1.5 overflow-y-auto font-mono text-xs\" id=\"nav-links\">\n          \n          <button\n            onClick={() => setCurrentView(\'dashboard\')}\n            className={`w-full flex items-center gap-3 px-4 py-3 rounded-xl transition-all cursor-pointer ${currentView === \'dashboard\' ? \'bg-orange-600 text-white font-bold shadow-md shadow-orange-600/10\' : \'text-neutral-400 hover:text-white hover:bg-neutral-900/40\'}`}\n          >\n            <LayoutDashboard size={16} />\n            <span>Dashboard</span>\n          </button>\n\n          <button\n            onClick={() => setCurrentView(\'clients\')}\n            className={`w-full flex items-center gap-3 px-4 py-3 rounded-xl transition-all cursor-pointer ${currentView === \'clients\' ? \'bg-orange-600 text-white font-bold shadow-md shadow-orange-600/10\' : \'text-neutral-400 hover:text-white hover:bg-neutral-900/40\'}`}\n          >\n            <Users size={16} />\n            <span>Clientes (CRM)</span>\n          </button>\n\n          <button\n            onClick={() => setCurrentView(\'filaments\')}\n            className={`w-full flex items-center gap-3 px-4 py-3 rounded-xl transition-all cursor-pointer ${currentView === \'filaments\' ? \'bg-orange-600 text-white font-bold shadow-md shadow-orange-600/10\' : \'text-neutral-400 hover:text-white hover:bg-neutral-900/40\'}`}\n          >\n            <Layers size={16} />\n            <span>Estoque Filamentos</span>\n          </button>\n\n          <button\n            onClick={() => setCurrentView(\'purchases\')}\n            className={`w-full flex items-center gap-3 px-4 py-3 rounded-xl transition-all cursor-pointer ${currentView === \'purchases\' ? \'bg-orange-600 text-white font-bold shadow-md shadow-orange-600/10\' : \'text-neutral-400 hover:text-white hover:bg-neutral-900/40\'}`}\n          >\n            <ShoppingBag size={16} />\n            <span>Compras Insumos</span>\n          </button>\n\n          <button\n            onClick={() => setCurrentView(\'printers\')}\n            className={`w-full flex items-center gap-3 px-4 py-3 rounded-xl transition-all cursor-pointer ${currentView === \'printers\' ? \'bg-orange-600 text-white font-bold shadow-md shadow-orange-600/10\' : \'text-neutral-400 hover:text-white hover:bg-neutral-900/40\'}`}\n          >\n            <Cpu size={16} />\n            <span>Impressoras</span>\n          </button>\n\n          <button\n            onClick={() => setCurrentView(\'tariffs\')}\n            className={`w-full flex items-center gap-3 px-4 py-3 rounded-xl transition-all cursor-pointer ${currentView === \'tariffs\' ? \'bg-orange-600 text-white font-bold shadow-md shadow-orange-600/10\' : \'text-neutral-400 hover:text-white hover:bg-neutral-900/40\'}`}\n          >\n            <Zap size={16} />\n            <span>Tarifa de Energia</span>\n          </button>\n\n          <button\n            onClick={() => setCurrentView(\'products\')}\n            className={`w-full flex items-center gap-3 px-4 py-3 rounded-xl transition-all cursor-pointer ${currentView === \'products\' ? \'bg-orange-600 text-white font-bold shadow-md shadow-orange-600/10\' : \'text-neutral-400 hover:text-white hover:bg-neutral-900/40\'}`}\n          >\n            <FolderHeart size={16} />\n            <span>Produtos / BOM</span>\n          </button>\n\n          <button\n            onClick={() => setCurrentView(\'production\')}\n            className={`w-full flex items-center gap-3 px-4 py-3 rounded-xl transition-all cursor-pointer ${currentView === \'production\' ? \'bg-orange-600 text-white font-bold shadow-md shadow-orange-600/10\' : \'text-neutral-400 hover:text-white hover:bg-neutral-900/40\'}`}\n          >\n            <PlayCircle size={16} />\n            <span>Produ\303\247\303\243o (Fila)</span>\n          </button>\n\n          <button\n            onClick={() => setCurrentView(\'budgets\')}\n            className={`w-full flex items-center gap-3 px-4 py-3 rounded-xl transition-all cursor-pointer ${currentView === \'budgets\' ? \'bg-orange-600 text-white font-bold shadow-md shadow-orange-600/10\' : \'text-neutral-400 hover:text-white hover:bg-neutral-900/40\'}`}\n          >\n            <FileCheck size={16} />\n            <span>Or\303\247amentos</span>\n          </button>\n\n          <button\n            onClick={() => setCurrentView(\'sales\')}\n            className={`w-full flex items-center gap-3 px-4 py-3 rounded-xl transition-all cursor-pointer ${currentView === \'sales\' ? \'bg-orange-600 text-white font-bold shadow-md shadow-orange-600/10\' : \'text-neutral-400 hover:text-white hover:bg-neutral-900/40\'}`}\n          >\n            <DollarSign size={16} />\n            <span>Vendas Realizadas</span>\n          </button>\n\n          <button\n            onClick={() => setCurrentView(\'backup\')}\n            className={`w-full flex items-center gap-3 px-4 py-3 rounded-xl transition-all cursor-pointer ${currentView === \'backup\' ? \'bg-orange-600 text-white font-bold shadow-md shadow-orange-600/10\' : \'text-neutral-400 hover:text-white hover:bg-neutral-900/40\'}`}\n          >\n            <Shield size={16} />\n            <span>Seguran\303\247a / Backup</span>\n          </button>\n\n        </nav>\n\n        {/* BOTTOM USER CARD PANEL */}\n        <div className=\"p-4 border-t border-neutral-900 bg-neutral-950/80\" id=\"sidebar-footer\">\n          <div className=\"flex items-center justify-between text-xs font-mono\">\n            <div className=\"truncate max-w-[140px]\">\n              <span className=\"text-[10px] text-neutral-500 uppercase block font-bold\">Usu\303\241rio Logado</span>\n              <span className=\"text-white font-semibold truncate block\" title={auth.email}>{auth.email}</span>\n            </div>\n            <button\n              onClick={() => setAuth({ isAuthenticated: false, email: \'\' })}\n              className=\"p-2 hover:bg-neutral-900 text-neutral-400 hover:text-red-500 rounded-lg cursor-pointer transition-colors\"\n              title=\"Encerrar Sess\303\243o\"\n              id=\"logout-btn\"\n            >\n              <LogOut size={16} />\n            </button>\n          </div>\n        </div>\n\n      </aside>\n\n      {/* MAIN CONTAINER PANELS */}\n      <main className=\"flex-1 bg-black overflow-y-auto flex flex-col min-h-0\" id=\"main-content-canvas\">\n        \n        {/* HEADER BRAND AND NOTIFICATIONS */}\n        <header className=\"px-8 py-5 border-b border-neutral-900 flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-neutral-950/20\" id=\"top-header\">\n          <div>\n            <h2 className=\"text-xs font-mono uppercase text-neutral-500 tracking-widest font-semibold\">Painel Administrador</h2>\n            <h1 className=\"text-lg font-black tracking-tight text-white mt-0.5\">ELMANEKO 3D ERP - MVP 2.0</h1>\n          </div>\n\n          {/* DYNAMIC LOW STOCK ALERT TOAST BANNER */}\n          {lowStockFilaments.length > 0 ? (\n            <div className=\"flex items-center gap-2 px-3 py-1.5 bg-amber-950/30 border border-amber-500/20 rounded-xl text-amber-400 text-xs font-mono\" id=\"low-stock-banner\">\n              <AlertTriangle size={15} className=\"text-amber-500 animate-pulse\" />\n              <span>Aviso: <strong>{lowStockFilaments.length} bobina(s)</strong> abaixo de 200g de massa!</span>\n            </div>\n          ) : (\n            <div className=\"flex items-center gap-1.5 px-3 py-1.5 bg-emerald-950/30 border border-emerald-500/10 rounded-xl text-emerald-400 text-xs font-mono\">\n              <span className=\"w-1.5 h-1.5 bg-emerald-500 rounded-full animate-ping\" />\n              <span>Insumos estocados conformes</span>\n            </div>\n          )}\n        </header>\n\n        {/* WORKSPACE SCENE ROUTING VIEWPORT */}\n        <div className=\"flex-1 px-8 py-8\" id=\"workspace-viewport\">\n          {currentView === \'dashboard\' && (\n            <Dashboard \n              filaments={filaments}\n              printers={printers}\n              products={products}\n              productions={productions}\n              sales={sales}\n            />\n          )}\n\n          {currentView === \'clients\' && (\n            <Clients\n              clients={clients}\n              onAddClient={handleAddClient}\n              onEditClient={handleEditClient}\n              onDeleteClient={handleDeleteClient}\n            />\n          )}\n\n          {currentView === \'filaments\' && (\n            <Filaments \n              filaments={filaments}\n              onAddFilament={handleAddFilament}\n              onEditFilament={handleEditFilament}\n              onDeleteFilament={handleDeleteFilament}\n            />\n          )}\n\n          {currentView === \'purchases\' && (\n            <Purchases \n              purchases={purchases}\n              filaments={filaments}\n              onAddPurchase={handleAddPurchase}\n            />\n          )}\n\n          {currentView === \'printers\' && (\n            <Printers \n              printers={printers}\n              onAddPrinter={handleAddPrinter}\n              onEditPrinter={handleEditPrinter}\n              onDeletePrinter={handleDeletePrinter}\n            />\n          )}\n\n          {currentView === \'tariffs\' && (\n            <EnergyTariffModule \n              tariffs={tariffs}\n              onAddTariff={handleAddTariff}\n            />\n          )}\n\n          {currentView === \'products\' && (\n            <Products \n              products={products}\n              printers={printers}\n              filaments={filaments}\n              tariffs={tariffs}\n              onAddProduct={handleAddProduct}\n              onEditProduct={handleEditProduct}\n              onDeleteProduct={handleDeleteProduct}\n            />\n          )}\n\n          {currentView === \'production\' && (\n            <Production \n              productions={productions}\n              products={products}\n              printers={printers}\n              filaments={filaments}\n              tariffs={tariffs}\n              onAddProduction={handleAddProduction}\n              onUpdateProductionStatus={handleUpdateProductionStatus}\n            />\n          )}\n\n          {currentView === \'budgets\' && (\n            <Budgets \n              budgets={budgets}\n              clients={clients}\n              products={products}\n              filaments={filaments}\n              onAddBudget={handleAddBudget}\n              onEditBudget={handleEditBudget}\n              onDeleteBudget={handleDeleteBudget}\n              onConvertToSale={handleConvertToSale}\n            />\n          )}\n\n          {currentView === \'sales\' && (\n            <Sales \n              sales={sales}\n              clients={clients}\n              products={products}\n              onUpdateSaleStatus={handleUpdateSaleStatus}\n            />\n          )}\n\n          {currentView === \'backup\' && (\n            <BackupModule \n              backupLogs={backupLogs}\n              onAddBackupLog={handleAddBackupLog}\n              onRestoreState={handleRestoreState}\n              currentState={{\n                filaments,\n                purchases,\n                printers,\n                tariffs,\n                products,\n                productions,\n                budgets,\n                sales,\n                clients\n              }}\n            />\n          )}\n        </div>\n\n      </main>\n\n    </div>\n  );\n}\n"
    }
