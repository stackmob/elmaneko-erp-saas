        lines {
          text: "                  {filteredProductions.length > 0 ? ("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    // sort by date descending"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                    [...filteredProductions].sort((a, b) => new Date(b.data).getTime() - new Date(a.data).getTime()).map(po => {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                      const prodObj = products.find(p => p.id === po.produtoId);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                      const printerObj = printers.find(p => p.id === po.impressoraId);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                      // calculate provisional rates if status is \'Em Produ\303\247\303\243o\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                      let displayUnitCost = po.custoUnitario;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                      let displayTotalCost = po.custoTotal;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                      if (po.status === \'Em Produ\303\247\303\243o\' && prodObj && printerObj) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        const tempFilCost = prodObj.materials.reduce((acc, mat) => {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                          const maxRate = getMaxCostPerGram(mat.tipoFilamento);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                          return acc + (mat.quantidadeGrams * maxRate);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        }, 0) * po.quantidade;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        const tempEnergyCost = (printerObj.potenciaWatts * prodObj.tempoImpressao) / 1000 * currentTariff * po.quantidade;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        const tempLaborCost = po.maoDeObraEscolha === \'unitario\' ? po.maoDeObraValor * po.quantidade : po.maoDeObraValor;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        displayTotalCost = tempFilCost + tempEnergyCost + tempLaborCost;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                        displayUnitCost = displayTotalCost / po.quantidade;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                      }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
