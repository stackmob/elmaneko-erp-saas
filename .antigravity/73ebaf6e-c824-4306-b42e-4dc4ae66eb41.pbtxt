          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    status VARCHAR(50) NOT NULL DEFAULT \'Em Produ\303\247\303\243o\' CHECK (status IN (\'Em Produ\303\247\303\243o\', \'Finalizada\', \'Cancelada\')),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
