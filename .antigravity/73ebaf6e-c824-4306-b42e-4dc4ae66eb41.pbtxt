        }
        lines {
          text: "    data DATE NOT NULL DEFAULT CURRENT_DATE,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    produto_id UUID NOT NULL REFERENCES public.produtos(id) ON DELETE RESTRICT,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    quantidade INTEGER NOT NULL CHECK (quantidade > 0),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    impressora_id UUID NOT NULL REFERENCES public.impressoras(id) ON DELETE RESTRICT,"
