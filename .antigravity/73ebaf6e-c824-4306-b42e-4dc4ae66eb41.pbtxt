        lines {
          text: "    impressora_padrao_id UUID REFERENCES public.impressoras(id) ON DELETE SET NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    tempo_acabamento NUMERIC(10,2) DEFAULT 0 CHECK (tempo_acabamento >= 0), -- em horas"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    valor_mao_de_obra NUMERIC(10,2) NOT NULL DEFAULT 0 CHECK (valor_mao_de_obra >= 0),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    observacoes TEXT,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    created_at TIMESTAMP WITH TIME ZONE DEFAULT timezone(\'utc\'::text, now()) NOT NULL,"
