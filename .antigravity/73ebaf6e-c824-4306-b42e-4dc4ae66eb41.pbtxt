          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "-- 11. MOVIMENTA\303\207\303\203O DE ESTOQUE (RASTREABILIDADE)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "-- ============================================================================"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "CREATE TABLE public.movimentacao_estoque ("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    data TIMESTAMP WITH TIME ZONE DEFAULT timezone(\'utc\'::text, now()) NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    tipo VARCHAR(10) NOT NULL CHECK (tipo IN (\'entrada\', \'saida\')),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    origem VARCHAR(50) NOT NULL CHECK (origem IN (\'compra\', \'producao_consumo\', \'producao_entrada\', \'venda_baixa\', \'ajuste\')),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    referencia_id UUID NOT NULL, -- id da tabela origem (compras, producoes, vendas, etc)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    filamento_id UUID REFERENCES public.filamentos(id) ON DELETE CASCADE,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    produto_id UUID REFERENCES public.produtos(id) ON DELETE CASCADE,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    quantidade NUMERIC(10,2) NOT NULL CHECK (quantidade > 0),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    descricao TEXT NOT NULL"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: ");"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "-- ============================================================================"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "-- 12. AUDITORIA E BACKUP LOGS"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "-- ============================================================================"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "CREATE TABLE public.backup_historico ("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    nome VARCHAR(255) NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    data DATE NOT NULL DEFAULT CURRENT_DATE,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    hora TIME NOT NULL DEFAULT CURRENT_TIME,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    usuario VARCHAR(255) NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    tipo VARCHAR(20) NOT NULL CHECK (tipo IN (\'Manual\', \'Autom\303\241tico\')),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    tamanho VARCHAR(50) NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    status VARCHAR(20) NOT NULL CHECK (status IN (\'Sucesso\', \'Erro\')),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    modulos TEXT[] NOT NULL"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: ");"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "CREATE TABLE public.restore_historico ("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    backup_id UUID REFERENCES public.backup_historico(id) ON DELETE SET NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    data TIMESTAMP WITH TIME ZONE DEFAULT timezone(\'utc\'::text, now()) NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    usuario VARCHAR(255) NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    tipo VARCHAR(20) NOT NULL,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    resultado VARCHAR(20) NOT NULL CHECK (resultado IN (\'Sucesso\', \'Erro\')),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    detalhes TEXT"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: ");"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "-- ============================================================================"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "-- 13. TRIGGERS E FUN\303\207\303\225ES AUTOM\303\201TICAS (PL/pgSQL)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "-- ============================================================================"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "-- A) Gatilho para atualizar a quantidade_disponivel de FILAMENTO ao salvar COMPRA"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "CREATE OR REPLACE FUNCTION public.proc_atualiza_estoque_por_compra()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "RETURNS TRIGGER AS $$"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "BEGIN"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    -- 1. Atualiza estoque do filamento"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    UPDATE public.filamentos"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    SET quantidade_disponivel = quantidade_disponivel + NEW.quantidade_adquirida,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        updated_at = now()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    WHERE id = NEW.filamento_id;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    -- 2. Registra na movimenta\303\247\303\243o de estoque"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    INSERT INTO public.movimentacao_estoque (tipo, origem, referencia_id, filamento_id, quantidade, descricao)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    VALUES ("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \'entrada\', "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \'compra\', "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        NEW.id, "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        NEW.filamento_id, "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        NEW.quantidade_adquirida, "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        \'Entrada de estoque via compra. Fornecedor: \' || NEW.fornecedor"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    );"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    RETURN NEW;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "END;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "$$ LANGUAGE plpgsql SECURITY DEFINER;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
