          text: "    descricao TEXT,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    imagem TEXT, -- URL da imagem armazenada no Supabase Storage"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    tempo_impressao NUMERIC(10,2) NOT NULL CHECK (tempo_impressao >= 0), -- em horas"
