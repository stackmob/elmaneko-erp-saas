        }
        lines {
          text: "    "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    mao_de_obra_escolha VARCHAR(50) NOT NULL DEFAULT \'unitario\' CHECK (mao_de_obra_escolha IN (\'unitario\', \'total\')),"
