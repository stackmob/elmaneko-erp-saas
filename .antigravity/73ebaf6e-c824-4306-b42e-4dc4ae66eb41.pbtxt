        }
        lines {
          text: "  const repProductions = productions.filter(po => {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    let match = po.status === \'Finalizada\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if (filterProduct !== \'todos\') match = match && po.produtoId === filterProduct;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if (filterPrinter !== \'todos\') match = match && po.impressoraId === filterPrinter;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if (filterDateStart) match = match && po.data >= filterDateStart;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if (filterDateEnd) match = match && po.data <= filterDateEnd;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    return match;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
