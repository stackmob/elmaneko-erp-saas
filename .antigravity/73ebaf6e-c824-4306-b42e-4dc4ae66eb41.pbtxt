          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    custo_mao_de_obra NUMERIC(10,2) NOT NULL DEFAULT 0,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    custo_total NUMERIC(10,2) NOT NULL DEFAULT 0,"
