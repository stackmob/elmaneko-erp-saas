        }
        lines {
          text: "  const repTotalFilamentCost = repProductions.reduce((acc, po) => acc + po.custoFilamento, 0);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const repTotalEnergyCost = repProductions.reduce((acc, po) => acc + po.custoEnergia, 0);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const repTotalLaborCost = repProductions.reduce((acc, po) => acc + po.custoMaoDeObra, 0);"
