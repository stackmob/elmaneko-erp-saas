        }
        lines {
          text: "  const filteredProductions = productions.filter(po => {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const matchesProduct = filterProduct === \'todos\' || po.produtoId === filterProduct;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const matchesPrinter = filterPrinter === \'todos\' || po.impressoraId === filterPrinter;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const matchesOperator = !filterOperator || (po.operador && po.operador.toLowerCase().includes(filterOperator.toLowerCase()));"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    let matchesDate = true;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if (filterDateStart) matchesDate = matchesDate && po.data >= filterDateStart;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if (filterDateEnd) matchesDate = matchesDate && po.data <= filterDateEnd;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    return matchesProduct && matchesPrinter && matchesOperator && matchesDate;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
