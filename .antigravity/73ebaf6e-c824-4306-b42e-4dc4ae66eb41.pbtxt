          text: "  const [paymentMethod, setPaymentMethod] = useState<\'Pix\' | \'Cart\303\243o de Cr\303\251dito\' | \'Cart\303\243o de D\303\251bito\' | \'Boleto\' | \'Dinheiro\'>(\'Pix\');"
