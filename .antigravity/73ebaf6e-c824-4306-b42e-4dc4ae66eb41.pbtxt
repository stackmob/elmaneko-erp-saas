    instruction: "Apply the Elegant Dark theme styling to the App layout container, sidebar, header, and navigation elements."
    replacement_infos {
      original_chunk {
        target_content: "  return (\n    <div className=\"min-h-screen bg-black text-white font-sans flex flex-col md:flex-row antialiased\" id=\"elmaneko-erp-app\">\n      \n      {/* SIDEBAR NAVIGATION PANEL */}\n      <aside className=\"w-full md:w-64 bg-neutral-950 border-r border-neutral-900 flex flex-col justify-between shrink-0\" id=\"sidebar\">\n        \n        {/* BRAND LOGO */}\n        <div className=\"p-6 border-b border-neutral-900\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-10 h-10 bg-gradient-to-tr from-orange-600 to-amber-500 rounded-xl flex items-center justify-center font-black text-white text-lg shadow-lg shadow-orange-600/10\">\n              E\n            </div>\n            <div>\n              <h1 className=\"text-md font-black tracking-tight text-white uppercase\">ELMANEKO 3D</h1>\n              <p className=\"text-[9px] font-mono tracking-widest text-orange-500 font-bold\">ERP CONTROL 2.0</p>\n            </div>\n          </div>\n        </div>\n\n        {/* NAVIGATION LINKS */}\n        <nav className=\"flex-1 px-4 py-6 space-y-1.5 overflow-y-auto font-mono text-xs\" id=\"nav-links\">\n          \n          <button\n            onClick={() => setCurrentView(\'dashboard\')}\n            className={`w-full flex items-center gap-3 px-4 py-3 rounded-xl transition-all cursor-pointer ${currentView === \'dashboard\' ? \'bg-orange-600 text-white font-bold shadow-md shadow-orange-600/10\' : \'text-neutral-400 hover:text-white hover:bg-neutral-900/40\'}`}\n          >\n            <LayoutDashboard size={16} />\n            <span>Dashboard</span>\n          </button>\n\n          <button\n            onClick={() => setCurrentView(\'clients\')}\n            className={`w-full flex items-center gap-3 px-4 py-3 rounded-xl transition-all cursor-pointer ${currentView === \'clients\' ? \'bg-orange-600 text-white font-bold shadow-md shadow-orange-600/10\' : \'text-neutral-400 hover:text-white hover:bg-neutral-900/40\'}`}\n          >\n            <Users size={16} />\n            <span>Clientes (CRM)</span>\n          </button>\n\n          <button\n            onClick={() => setCurrentView(\'filaments\')}\n            className={`w-full flex items-center gap-3 px-4 py-3 rounded-xl transition-all cursor-pointer ${currentView === \'filaments\' ? \'bg-orange-600 text-white font-bold shadow-md shadow-orange-600/10\' : \'text-neutral-400 hover:text-white hover:bg-neutral-900/40\'}`}\n          >\n            <Layers size={16} />\n            <span>Estoque Filamentos</span>\n          </button>\n\n          <button\n            onClick={() => setCurrentView(\'purchases\')}\n            className={`w-full flex items-center gap-3 px-4 py-3 rounded-xl transition-all cursor-pointer ${currentView === \'purchases\' ? \'bg-orange-600 text-white font-bold shadow-md shadow-orange-600/10\' : \'text-neutral-400 hover:text-white hover:bg-neutral-900/40\'}`}\n          >\n            <ShoppingBag size={16} />\n            <span>Compras Insumos</span>\n          </button>\n\n          <button\n            onClick={() => setCurrentView(\'printers\')}\n            className={`w-full flex items-center gap-3 px-4 py-3 rounded-xl transition-all cursor-pointer ${currentView === \'printers\' ? \'bg-orange-600 text-white font-bold shadow-md shadow-orange-600/10\' : \'text-neutral-400 hover:text-white hover:bg-neutral-900/40\'}`}\n          >\n            <Cpu size={16} />\n            <span>Impressoras</span>\n          </button>\n\n          <button\n            onClick={() => setCurrentView(\'tariffs\')}\n            className={`w-full flex items-center gap-3 px-4 py-3 rounded-xl transition-all cursor-pointer ${currentView === \'tariffs\' ? \'bg-orange-600 text-white font-bold shadow-md shadow-orange-600/10\' : \'text-neutral-400 hover:text-white hover:bg-neutral-900/40\'}`}\n          >\n            <Zap size={16} />\n            <span>Tarifa de Energia</span>\n          </button>\n\n          <button\n            onClick={() => setCurrentView(\'products\')}\n            className={`w-full flex items-center gap-3 px-4 py-3 rounded-xl transition-all cursor-pointer ${currentView === \'products\' ? \'bg-orange-600 text-white font-bold shadow-md shadow-orange-600/10\' : \'text-neutral-400 hover:text-white hover:bg-neutral-900/40\'}`}\n          >\n            <FolderHeart size={16} />\n            <span>Produtos / BOM</span>\n          </button>\n\n          <button\n            onClick={() => setCurrentView(\'production\')}\n            className={`w-full flex items-center gap-3 px-4 py-3 rounded-xl transition-all cursor-pointer ${currentView === \'production\' ? \'bg-orange-600 text-white font-bold shadow-md shadow-orange-600/10\' : \'text-neutral-400 hover:text-white hover:bg-neutral-900/40\'}`}\n          >\n            <PlayCircle size={16} />\n            <span>Produ\303\247\303\243o (Fila)</span>\n          </button>\n\n          <button\n            onClick={() => setCurrentView(\'budgets\')}\n            className={`w-full flex items-center gap-3 px-4 py-3 rounded-xl transition-all cursor-pointer ${currentView === \'budgets\' ? \'bg-orange-600 text-white font-bold shadow-md shadow-orange-600/10\' : \'text-neutral-400 hover:text-white hover:bg-neutral-900/40\'}`}\n          >\n            <FileCheck size={16} />\n            <span>Or\303\247amentos</span>\n          </button>\n\n          <button\n            onClick={() => setCurrentView(\'sales\')}\n            className={`w-full flex items-center gap-3 px-4 py-3 rounded-xl transition-all cursor-pointer ${currentView === \'sales\' ? \'bg-orange-600 text-white font-bold shadow-md shadow-orange-600/10\' : \'text-neutral-400 hover:text-white hover:bg-neutral-900/40\'}`}\n          >\n            <DollarSign size={16} />\n            <span>Vendas Realizadas</span>\n          </button>\n\n          <button\n            onClick={() => setCurrentView(\'backup\')}\n            className={`w-full flex items-center gap-3 px-4 py-3 rounded-xl transition-all cursor-pointer ${currentView === \'backup\' ? \'bg-orange-600 text-white font-bold shadow-md shadow-orange-600/10\' : \'text-neutral-400 hover:text-white hover:bg-neutral-900/40\'}`}\n          >\n            <Shield size={16} />\n            <span>Seguran\303\247a / Backup</span>\n          </button>\n\n        </nav>\n\n        {/* BOTTOM USER CARD PANEL */}\n        <div className=\"p-4 border-t border-neutral-900 bg-neutral-950/80\" id=\"sidebar-footer\">\n          <div className=\"flex items-center justify-between text-xs font-mono\">\n            <div className=\"truncate max-w-[140px]\">\n              <span className=\"text-[10px] text-neutral-500 uppercase block font-bold\">Usu\303\241rio Logado</span>\n              <span className=\"text-white font-semibold truncate block\" title={auth.email}>{auth.email}</span>\n            </div>\n            <button\n              onClick={() => setAuth({ isAuthenticated: false, email: \'\' })}\n              className=\"p-2 hover:bg-neutral-900 text-neutral-400 hover:text-red-500 rounded-lg cursor-pointer transition-colors\"\n              title=\"Encerrar Sess\303\243o\"\n              id=\"logout-btn\"\n            >\n              <LogOut size={16} />\n            </button>\n          </div>\n        </div>\n\n      </aside>\n\n      {/* MAIN CONTAINER PANELS */}\n      <main className=\"flex-1 bg-black overflow-y-auto flex flex-col min-h-0\" id=\"main-content-canvas\">\n        \n        {/* HEADER BRAND AND NOTIFICATIONS */}\n        <header className=\"px-8 py-5 border-b border-neutral-900 flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-neutral-950/20\" id=\"top-header\">\n          <div>\n            <h2 className=\"text-xs font-mono uppercase text-neutral-500 tracking-widest font-semibold\">Painel Administrador</h2>\n            <h1 className=\"text-lg font-black tracking-tight text-white mt-0.5\">ELMANEKO 3D ERP - MVP 2.0</h1>\n          </div>\n\n          {/* DYNAMIC LOW STOCK ALERT TOAST BANNER */}\n          {lowStockFilaments.length > 0 ? (\n            <div className=\"flex items-center gap-2 px-3 py-1.5 bg-amber-950/30 border border-amber-500/20 rounded-xl text-amber-400 text-xs font-mono\" id=\"low-stock-banner\">\n              <AlertTriangle size={15} className=\"text-amber-500 animate-pulse\" />\n              <span>Aviso: <strong>{lowStockFilaments.length} bobina(s)</strong> abaixo de 200g de massa!</span>\n            </div>\n          ) : (\n            <div className=\"flex items-center gap-1.5 px-3 py-1.5 bg-emerald-950/30 border border-emerald-500/10 rounded-xl text-emerald-400 text-xs font-mono\">"
        replacement_content: "  return (\n    <div className=\"min-h-screen bg-neutral-950 text-neutral-100 font-sans flex flex-col md:flex-row antialiased\" id=\"elmaneko-erp-app\">\n      \n      {/* SIDEBAR NAVIGATION PANEL */}\n      <aside className=\"w-full md:w-64 bg-neutral-900/50 border-r border-neutral-800 flex flex-col justify-between shrink-0\" id=\"sidebar\">\n        \n        {/* BRAND LOGO */}\n        <div className=\"p-6 border-b border-neutral-800\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-8 h-8 bg-orange-600 rounded flex items-center justify-center font-bold text-white shadow-md shadow-orange-600/10\">\n              E3\n            </div>\n            <div>\n              <h1 className=\"text-base font-bold tracking-tight text-white\">ELMANEKO <span className=\"text-orange-500\">3D</span></h1>\n              <p className=\"text-[9px] font-mono tracking-widest text-neutral-500 font-semibold uppercase\">ERP CONTROL 2.0</p>\n            </div>\n          </div>\n        </div>\n\n        {/* NAVIGATION LINKS */}\n        <nav className=\"flex-1 px-4 py-6 space-y-1.5 overflow-y-auto font-mono text-xs\" id=\"nav-links\">\n          \n          <button\n            onClick={() => setCurrentView(\'dashboard\')}\n            className={`w-full flex items-center gap-3 px-3 py-2.5 rounded-lg transition-all cursor-pointer border ${currentView === \'dashboard\' ? \'bg-orange-500/10 text-orange-500 border-orange-500/20 font-semibold\' : \'text-neutral-400 border-transparent hover:bg-neutral-800/50 hover:text-neutral-200\'}`}\n          >\n            <LayoutDashboard size={16} />\n            <span>Dashboard</span>\n          </button>\n\n          <button\n            onClick={() => setCurrentView(\'clients\')}\n            className={`w-full flex items-center gap-3 px-3 py-2.5 rounded-lg transition-all cursor-pointer border ${currentView === \'clients\' ? \'bg-orange-500/10 text-orange-500 border-orange-500/20 font-semibold\' : \'text-neutral-400 border-transparent hover:bg-neutral-800/50 hover:text-neutral-200\'}`}\n          >\n            <Users size={16} />\n            <span>Clientes (CRM)</span>\n          </button>\n\n          <button\n            onClick={() => setCurrentView(\'filaments\')}\n            className={`w-full flex items-center gap-3 px-3 py-2.5 rounded-lg transition-all cursor-pointer border ${currentView === \'filaments\' ? \'bg-orange-500/10 text-orange-500 border-orange-500/20 font-semibold\' : \'text-neutral-400 border-transparent hover:bg-neutral-800/50 hover:text-neutral-200\'}`}\n          >\n            <Layers size={16} />\n            <span>Estoque Filamentos</span>\n          </button>\n\n          <button\n            onClick={() => setCurrentView(\'purchases\')}\n            className={`w-full flex items-center gap-3 px-3 py-2.5 rounded-lg transition-all cursor-pointer border ${currentView === \'purchases\' ? \'bg-orange-500/10 text-orange-500 border-orange-500/20 font-semibold\' : \'text-neutral-400 border-transparent hover:bg-neutral-800/50 hover:text-neutral-200\'}`}\n          >\n            <ShoppingBag size={16} />\n            <span>Compras Insumos</span>\n          </button>\n\n          <button\n            onClick={() => setCurrentView(\'printers\')}\n            className={`w-full flex items-center gap-3 px-3 py-2.5 rounded-lg transition-all cursor-pointer border ${currentView === \'printers\' ? \'bg-orange-500/10 text-orange-500 border-orange-500/20 font-semibold\' : \'text-neutral-400 border-transparent hover:bg-neutral-800/50 hover:text-neutral-200\'}`}\n          >\n            <Cpu size={16} />\n            <span>Impressoras</span>\n          </button>\n\n          <button\n            onClick={() => setCurrentView(\'tariffs\')}\n            className={`w-full flex items-center gap-3 px-3 py-2.5 rounded-lg transition-all cursor-pointer border ${currentView === \'tariffs\' ? \'bg-orange-500/10 text-orange-500 border-orange-500/20 font-semibold\' : \'text-neutral-400 border-transparent hover:bg-neutral-800/50 hover:text-neutral-200\'}`}\n          >\n            <Zap size={16} />\n            <span>Tarifa de Energia</span>\n          </button>\n\n          <button\n            onClick={() => setCurrentView(\'products\')}\n            className={`w-full flex items-center gap-3 px-3 py-2.5 rounded-lg transition-all cursor-pointer border ${currentView === \'products\' ? \'bg-orange-500/10 text-orange-500 border-orange-500/20 font-semibold\' : \'text-neutral-400 border-transparent hover:bg-neutral-800/50 hover:text-neutral-200\'}`}\n          >\n            <FolderHeart size={16} />\n            <span>Produtos / BOM</span>\n          </button>\n\n          <button\n            onClick={() => setCurrentView(\'production\')}\n            className={`w-full flex items-center gap-3 px-3 py-2.5 rounded-lg transition-all cursor-pointer border ${currentView === \'production\' ? \'bg-orange-500/10 text-orange-500 border-orange-500/20 font-semibold\' : \'text-neutral-400 border-transparent hover:bg-neutral-800/50 hover:text-neutral-200\'}`}\n          >\n            <PlayCircle size={16} />\n            <span>Produ\303\247\303\243o (Fila)</span>\n          </button>\n\n          <button\n            onClick={() => setCurrentView(\'budgets\')}\n            className={`w-full flex items-center gap-3 px-3 py-2.5 rounded-lg transition-all cursor-pointer border ${currentView === \'budgets\' ? \'bg-orange-500/10 text-orange-500 border-orange-500/20 font-semibold\' : \'text-neutral-400 border-transparent hover:bg-neutral-800/50 hover:text-neutral-200\'}`}\n          >\n            <FileCheck size={16} />\n            <span>Or\303\247amentos</span>\n          </button>\n\n          <button\n            onClick={() => setCurrentView(\'sales\')}\n            className={`w-full flex items-center gap-3 px-3 py-2.5 rounded-lg transition-all cursor-pointer border ${currentView === \'sales\' ? \'bg-orange-500/10 text-orange-500 border-orange-500/20 font-semibold\' : \'text-neutral-400 border-transparent hover:bg-neutral-800/50 hover:text-neutral-200\'}`}\n          >\n            <DollarSign size={16} />\n            <span>Vendas Realizadas</span>\n          </button>\n\n          <button\n            onClick={() => setCurrentView(\'backup\')}\n            className={`w-full flex items-center gap-3 px-3 py-2.5 rounded-lg transition-all cursor-pointer border ${currentView === \'backup\' ? \'bg-orange-500/10 text-orange-500 border-orange-500/20 font-semibold\' : \'text-neutral-400 border-transparent hover:bg-neutral-800/50 hover:text-neutral-200\'}`}\n          >\n            <Shield size={16} />\n            <span>Seguran\303\247a / Backup</span>\n          </button>\n\n        </nav>\n\n        {/* BOTTOM USER CARD PANEL */}\n        <div className=\"p-4 border-t border-neutral-800\" id=\"sidebar-footer\">\n          <div className=\"flex items-center gap-3 bg-neutral-900/60 p-3 rounded-xl border border-neutral-800/60\">\n            <div className=\"w-8 h-8 rounded-full bg-orange-600/15 border border-orange-500/25 flex items-center justify-center text-orange-500 text-xs font-bold uppercase shrink-0\">\n              {auth.email ? auth.email[0] : \'A\'}\n            </div>\n            <div className=\"overflow-hidden flex-1 font-mono\">\n              <p className=\"text-xs font-semibold text-neutral-200\">Admin Elmaneko</p>\n              <p className=\"text-[10px] text-neutral-500 truncate\" title={auth.email}>{auth.email}</p>\n            </div>\n            <button\n              onClick={() => setAuth({ isAuthenticated: false, email: \'\' })}\n              className=\"p-1.5 hover:bg-neutral-800 text-neutral-400 hover:text-red-500 rounded-lg cursor-pointer transition-colors\"\n              title=\"Encerrar Sess\303\243o\"\n              id=\"logout-btn\"\n            >\n              <LogOut size={14} />\n            </button>\n          </div>\n        </div>\n\n      </aside>\n\n      {/* MAIN CONTAINER PANELS */}\n      <main className=\"flex-1 bg-neutral-950 overflow-y-auto flex flex-col min-h-0\" id=\"main-content-canvas\">\n        \n        {/* HEADER BRAND AND NOTIFICATIONS */}\n        <header className=\"px-8 py-4 border-b border-neutral-800 flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-neutral-900/20\" id=\"top-header\">\n          <div>\n            <h2 className=\"text-[10px] font-mono uppercase text-neutral-500 tracking-wider font-semibold\">Painel Administrador</h2>\n            <h1 className=\"text-base font-bold tracking-tight text-white mt-0.5\">ELMANEKO 3D ERP - MVP 2.0</h1>\n          </div>\n\n          {/* DYNAMIC LOW STOCK ALERT TOAST BANNER */}\n          {lowStockFilaments.length > 0 ? (\n            <div className=\"flex items-center gap-2 px-3 py-1.5 bg-amber-950/30 border border-amber-500/20 rounded-xl text-amber-400 text-xs font-mono\" id=\"low-stock-banner\">\n              <AlertTriangle size={15} className=\"text-amber-500 animate-pulse\" />\n              <span>Aviso: <strong>{lowStockFilaments.length} bobina(s)</strong> abaixo de 200g de massa!</span>\n            </div>\n          ) : (\n            <div className=\"flex items-center gap-1.5 px-3 py-1.5 bg-emerald-950/30 border border-emerald-500/10 rounded-xl text-emerald-400 text-xs font-mono\">"
      }
      num_matches: 1
    }
  }
}
